{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\mssqllocaldb;Database=DocumentSearch;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Storage": {
    "RootPath": "./Documents"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexName": "documents"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Username": "guest",
    "Password": "guest",
    "VirtualHost": "/"
  },
  "Ocr": {
    "TesseractDataPath": "./tessdata",
    "Language": "eng",
    "MinCharsPerPageForDigitalPdf": 50
  },
  "Ingestion": {
    "MaxParallelJobs": 4,
    "BulkBatchSize": 500,
    "MaxRetries": 3
  }
}
