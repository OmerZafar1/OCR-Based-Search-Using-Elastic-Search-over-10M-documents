{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "DocumentSearch": "Information"
    }
  },
  "Upload": {
    "MaxRequestBodySizeBytes": 1073741824,
    "MaxFilesPerRequest": 200,
    "RecommendBulkIndexThreshold": 500,
    "ClientParallelUploads": 8
  },
  "Ingestion": {
    "MaxParallelJobs": 8,
    "BulkBatchSize": 1000,
    "MaxRetries": 3
  }
}
